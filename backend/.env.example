# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=your_openai_api_key

# 사용할 OpenAI 모델 (선택, 기본값 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Firebase 서비스 계정 키(JSON) 전체 내용을 한 줄 문자열로 넣습니다.
# 예: {"type":"service_account","project_id":"your_project_id",...}
FIREBASE_SERVICE_ACCOUNT_JSON=your_firebase_service_account_json

# 프론트엔드 주소. 여러 주소는 쉼표로 구분합니다.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

